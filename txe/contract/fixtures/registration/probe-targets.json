{
  "rule": "A target probed before a run (existence_check pre_run) or periodically (reconcile) must be observable. kubernetes.{configmap,secret,service,persistentvolumeclaim,deployment,statefulset,job,cronjob} are namespaced and kubernetes.namespace is cluster-scoped: environment is the cluster and is required; stable_id has exactly {cluster_uid, uid}, non-empty and unpadded; display_name is exactly 'namespace/name' (namespaced) or 'name' (cluster-scoped); a credential reference 'kubernetes' of kind file is required and 'kubernetes_context', if present, is of kind env. linear.issue: stable_id has exactly {id}; a credential reference 'linear' of kind env or file is required. Any other kind must be event_only. event_only targets are not checked.",
  "accepted": [
    {
      "target": {
        "kind": "kubernetes.configmap",
        "environment": "dev",
        "stable_id": {
          "cluster_uid": "c1",
          "uid": "u1"
        },
        "display_name": "probe-ns/settings",
        "existence_check": "pre_run"
      },
      "credential_refs": [
        {
          "name": "kubernetes",
          "kind": "file",
          "locator": "/Users/me/.kube/config"
