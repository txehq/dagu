# One run of this DAG carries one proposal as a native human task.
# Rendered by `dagu txe review render`; do not edit the installed copy.
#
# The run id is derived from the proposal, so opening a proposal twice is
# refused instead of creating a second task. Waiting holds no process and no
# worker slot, and unanswered proposals do not block each other.
description: Human decision for one TXE proposal on {{.MachineID}}
# The run's process, once a person has answered, may last as long as every
# wait of the execute step below plus one whole try of it. The timeout is
# stated here so that the run never inherits a shorter one from a base
# configuration. Waiting for the person holds no process and is not counted.
timeout_sec: {{.DecideTimeoutSec}}
# Runs are kept with their logs and artifacts. Without this the run
# history would get Dagu's 30-day default, or a base configuration's, and
# a run started with local storage would remove older runs. Dagu has no
# value that turns the removal off; 100 years postpones it.
hist_retention_days: {{.HistRetentionDays}}
working_dir: {{yaml .StateDir}}
worker_selector:
  txe.machine: {{yaml .MachineID}}
env:
{{- range .Vars}}
  - {{.Name}}: {{yaml .Value}}
{{- end}}
params:
  - JOB_ID: ""
  - PROPOSAL_ID: ""
steps:
  - id: decide
    action: human.task
    with:
      prompt: "Decide TXE proposal ${PROPOSAL_ID} of job ${JOB_ID} in the TXE inbox."
      form:
        type: object
        properties:
          decision_id:
            type: string
          verdict:
            type: string
            # superseded is written only by the system when it closes the run
            # of a proposal nobody can answer any more. It is not a verdict.
            enum: [approve, reject, redirect, retry, pause, snooze, retire, superseded]
        required: [decision_id, verdict]

  # The task input only points at the decision. The registry's own record of
  # that decision decides whether anything runs: every verdict but approve
  # exits without an effect, and an approval is rechecked against the job as
  # it is now.
  - id: execute
    depends: decide
    timeout_sec: {{.TimeoutSec}}
    # A job claimed by another holder is waited for, and nothing else is
    # retried: the command exits {{.ExitClaimHeld}} for that alone. A review that died
    # keeps its claim for up to {{.MaxClaimTTLSec}} seconds, and the waits below add up to
    # more than that, so an approved action runs by itself once the claim
    # is gone. Each try reads the decision and the job again. If the wait
    # runs out the run fails and can be retried from the dashboard.
    retry_policy:
      limit: {{.ClaimWaitRetries}}
      interval_sec: {{.ClaimWaitIntervalSec}}
      exit_code: [{{.ExitClaimHeld}}]
    # Parameters and task input reach the command only as quoted variables,
    # never as shell text.
    env:
      - TXE_JOB_ID: ${JOB_ID}
      - TXE_PROPOSAL_ID: ${PROPOSAL_ID}
      - TXE_DECISION_ID: ${steps.decide.outputs.decision_id}
    run: {{.ReviewCommand}} execute --machine {{.MachineID}} --run-id ${DAG_RUN_ID} --job "$TXE_JOB_ID" --proposal "$TXE_PROPOSAL_ID" --decision "$TXE_DECISION_ID"
